#!/bin/bash
#
# mac-sandbox: Generic macOS sandbox wrapper for CLI tools
# Enforces OS-level file write restrictions via sandbox-exec
#
# App name is inferred from how this wrapper is invoked:
#   opencode-sandbox → opencode
#   claude-sandbox   → claude
#
# Install: curl -fsSL https://raw.githubusercontent.com/minhtuannguyen/mac_sandbox/main/install.sh | bash
#

set -e

# --- App identity ---
# Strip the "-sandbox" suffix from $0 to get the app name.
APP_NAME="$(basename "$0" | sed 's/-sandbox$//')"

# --- Paths ---
SANDBOX_CONFIG="${HOME}/.config/mac-sandbox/${APP_NAME}.json"
SB_PROFILE="/tmp/${APP_NAME}-sandbox-$$.sb"

# --- Logging ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo -e "${GREEN}[${APP_NAME}-sandbox]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[${APP_NAME}-sandbox]${NC} $1"; }
log_error() { echo -e "${RED}[${APP_NAME}-sandbox]${NC} $1" >&2; }

# Resolve the binary name: use 'program' from config if set, else APP_NAME.
resolve_program_name() {
  local p
  p="$(jq -r '.program // empty' "$SANDBOX_CONFIG" 2>/dev/null)"
  echo "${p:-$APP_NAME}"
}

# Locate the real app binary in PATH, skipping this wrapper script.
# Prints the resolved path, or returns 1 if not found.
find_app_bin() {
  local program script_path candidate
  program="$(resolve_program_name)"
  script_path="$(realpath "$0")"
  while IFS= read -r -d: path || [[ -n "$path" ]]; do
    candidate="${path}/${program}"
    if [[ -f "$candidate" && -x "$candidate" && "$(realpath "$candidate")" != "$script_path" ]]; then
      echo "$candidate"
      return 0
    fi
  done <<< "${PATH}:"
  return 1
}

# Write a minimal default config if none exists.
ensure_config() {
  [[ -f "$SANDBOX_CONFIG" ]] && return
  log_error "Sandbox config not found: $SANDBOX_CONFIG"
  log_info "Creating minimal default config..."
  mkdir -p "${HOME}/.config/mac-sandbox"
  cat > "$SANDBOX_CONFIG" << EOF
{
  "sandbox_enabled": true,
  "allowed_directories": [
    "${HOME}/repositories/**"
  ],
  "state_dirs": [],
  "temp_allowed": true,
  "network": "full",
  "process_spawning": "allowed"
}
EOF
  log_info "Config created: $SANDBOX_CONFIG"
  log_info "Edit it to set allowed_directories and state_dirs for ${APP_NAME}."
}

# Print each allowed directory (glob-stripped) to stdout.
parse_allowed_dirs() {
  jq -r '.allowed_directories[]' "$SANDBOX_CONFIG" 2>/dev/null | while IFS= read -r dir; do
    dir="${dir//\~/$HOME}"
    dir="${dir//\*\*/*}"
    echo "$dir"
  done
}

# Write the sandbox profile to the given path.
# Strategy: deny default, allow all reads, deny all writes, then re-allow
# writes only to the directories listed in config (allowed_directories + state_dirs).
generate_sandbox_profile() {
  local profile="$1"

  # Unquoted heredoc so $HOME / $APP_NAME expand
  cat > "$profile" << SANDBOX_HEADER
; macOS Sandbox Profile — generated by mac-sandbox for ${APP_NAME}

(version 1)
(deny default)

; Allow all reads — the real security boundary is write access.
(allow file-read*)

; Allow mapping files as executable memory (required for dlopen / dylib loading)
(allow file-map-executable)

; Essential process and IPC operations
(allow process-info*)
(allow signal (target self))
(allow mach-lookup)
(allow mach-register)
(allow ipc-posix-shm)
(allow ipc-posix-sem)
(allow sysctl-read)

; Terminal (TTY) control — required for raw mode / interactive UI
; file-ioctl covers tcsetattr (setRawMode) on the TTY device node
(allow file-ioctl)
(allow file-write* (subpath "/dev"))

; Deny all writes; only explicitly listed paths are re-allowed below.
(deny file-write*)
SANDBOX_HEADER

  # User project directories (from allowed_directories)
  jq -r '.allowed_directories[]' "$SANDBOX_CONFIG" 2>/dev/null | while IFS= read -r dir; do
    dir="${dir//\~/$HOME}"
    local dir_prefix="${dir%%\**}"   # strip glob suffix
    cat >> "$profile" << EOF
(allow file-write* (prefix "$dir_prefix"))
EOF
  done

  # App state directories (config/data/state the app itself needs to write)
  jq -r '.state_dirs[]?' "$SANDBOX_CONFIG" 2>/dev/null | while IFS= read -r dir; do
    dir="${dir//\~/$HOME}"
    # Ensure trailing slash for prefix match
    [[ "$dir" != */ ]] && dir="${dir}/"
    cat >> "$profile" << EOF
(allow file-write* (prefix "$dir"))
EOF
  done

  # Temp directories
  if [[ "$(jq -r '.temp_allowed // true' "$SANDBOX_CONFIG" 2>/dev/null)" == "true" ]]; then
    cat >> "$profile" << 'TEMP_RULES'
(allow file-write* (prefix "/tmp"))
(allow file-write* (prefix "/private/tmp"))
(allow file-write* (prefix "/var/tmp"))
(allow file-write* (prefix "/private/var/tmp"))
(allow file-write* (prefix "/private/var/folders"))
TEMP_RULES
  fi

  # Process spawning — allow fork/exec only if enabled
  if [[ "$(jq -r '.process_spawning // "allowed"' "$SANDBOX_CONFIG" 2>/dev/null)" == "allowed" ]]; then
    cat >> "$profile" << 'PROCESS_RULES'
(allow process-fork)
(allow process-exec*)
PROCESS_RULES
  fi

  # Network access — allow network only if enabled
  if [[ "$(jq -r '.network // "full"' "$SANDBOX_CONFIG" 2>/dev/null)" == "full" ]]; then
    cat >> "$profile" << 'NETWORK_RULES'
(allow network*)
NETWORK_RULES
  fi

  # Privilege escalation — deny system-privilege ops if enabled (default: true)
  if [[ "$(jq -r '.deny_privilege_escalation // true' "$SANDBOX_CONFIG" 2>/dev/null)" == "true" ]]; then
    cat >> "$profile" << 'PRIVESC_RULES'
; Block privilege escalation — approximates PR_SET_NO_NEW_PRIVS
(deny system-privilege)
PRIVESC_RULES
  fi
}

# --- Main ---

ensure_config

APP_BIN="$(find_app_bin)" || {
  log_error "Could not find '$(resolve_program_name)' binary in PATH (excluding this wrapper)"
  exit 1
}

if [[ "$(jq -r '.sandbox_enabled // true' "$SANDBOX_CONFIG" 2>/dev/null)" != "true" ]]; then
  log_warn "Sandbox disabled in config. Running ${APP_NAME} without sandbox..."
  exec "$APP_BIN" "$@"
fi

generate_sandbox_profile "$SB_PROFILE"

log_info "Sandbox profile generated: $SB_PROFILE"
log_info "Allowed directories:"
parse_allowed_dirs | sed 's/^/  - /'
log_info "Launching ${APP_NAME} in sandbox..."

sandbox-exec -f "$SB_PROFILE" "$APP_BIN" "$@"
EXIT_CODE=$?

rm -f "$SB_PROFILE"
exit $EXIT_CODE
