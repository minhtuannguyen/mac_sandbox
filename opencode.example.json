{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",

      "rm *": "deny",
      "mkdir *": "deny",
      "touch *": "deny",
      "mv *": "deny",
      "cp *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "ln *": "deny",
      "truncate *": "deny",
      "tee *": "deny",
      "rsync *": "deny",
      "dd *": "deny",
      "install *": "deny",

      "git *": "deny",

      "git log": "allow",
      "git log *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git branch": "allow",
      "git stash list": "allow",
      "git tag": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git describe *": "allow",
      "git rev-parse *": "allow",
      "git shortlog *": "allow",

      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "which *": "allow",
      "type *": "allow",
      "pwd": "allow",
      "tree *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "awk *": "allow",
      "echo *": "allow",
      "env": "allow",
      "printenv": "allow",
      "printenv *": "allow",

      "npm *": "allow"

    }
  }
}
